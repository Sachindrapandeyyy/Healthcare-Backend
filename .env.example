# Django Healthcare Backend Configuration
SECRET_KEY=django-insecure-healthcare-secret-key-prod-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Use 'django.db.backends.postgresql' for PostgreSQL
# Use 'django.db.backends.sqlite3' for local SQLite development
DB_ENGINE=django.db.backends.postgresql
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Simple JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
